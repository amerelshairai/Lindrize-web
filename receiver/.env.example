# Copy this file to ".env" on the server and fill in the values there.
# Never put real values in this file and never commit ".env" to GitHub.

# The site address that may send designs. While the test address is in use, list both,
# separated by a comma: https://lindrize.online,https://new.lindrize.online
ALLOWED_ORIGIN=https://lindrize.online

# Cloudflare Turnstile secret key (Cloudflare dashboard > Turnstile > your site).
TURNSTILE_SECRET=

# Mail server used to send the emails (Google Workspace: smtp.gmail.com, port 465, an app password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Lindrize <amer.ai@lindrize.online>"
OWNER_EMAIL=amer.ai@lindrize.online

# Optional Telegram alert (BotFather token and the chat id to notify).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
