# Copy to /srv/lindrize/.env on the server and fill in. Never commit the real file.
# Create each value on the server with:   openssl rand -hex 32
# (letters and digits only, so nothing needs quoting)

UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=
UMAMI_TWO_FACTOR_KEY=

# "preview" until launch day, then "live" (docs/DNS-MOVE.md).
LINDRIZE_STAGE=preview
