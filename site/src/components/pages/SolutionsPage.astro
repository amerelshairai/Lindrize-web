---
import { breadcrumbs } from '@/lib/schema';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHead from '@/components/PageHead.astro';
import SystemsTable from '@/components/home/SystemsTable.astro';
import FinalCta from '@/components/home/FinalCta.astro';
import { ui, tr, ROUTES, type Lang } from '@/lib/i18n';
import { getSystems, getIndustries, pageCopy, GROUP_ORDER, fill } from '@/lib/content';
import { getEntry } from 'astro:content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = await pageCopy('solutionsPage', 'solutions');
const systems = await getSystems();
const industries = await getIndustries();
const home = (await getEntry('home', 'home'))?.data;
if (!home) throw new Error('home.yaml is missing');
const statuses = ['live-demo', 'available', 'on-request'] as const;
---

<BaseLayout
  lang={lang}
  title={tr(c.seo.title, lang)}
  description={tr(c.seo.description, lang)}
  page={ROUTES.solutions}
  schema={[breadcrumbs(lang, [{ name: tr(c.title, lang), page: ROUTES.solutions }])]}
>
  <PageHead title={tr(c.title, lang)} lead={tr(c.lead, lang)} />

  <section class="list">
    <div class="wrap">
      <form class="filters js-only" role="search" data-filters>
        <div class="field">
          <label for="system-search">{tr(c.searchLabel, lang)}</label>
          <input id="system-search" type="search" name="q" placeholder={tr(c.searchPlaceholder, lang)} autocomplete="off" />
        </div>
        <fieldset class="field">
          <legend>{tr(c.groupLabel, lang)}</legend>
          <div class="segments">
            <label><input type="radio" name="group" value="" checked /><span>{tr(c.all, lang)}</span></label>
            {
              GROUP_ORDER.map((group) => (
                <label>
                  <input type="radio" name="group" value={group} />
                  <span>{tr(c.groups[group].name, lang)}</span>
                </label>
              ))
            }
          </div>
        </fieldset>
        <div class="field">
          <label for="system-industry">{tr(c.industryLabel, lang)}</label>
          <select id="system-industry" name="industry">
            <option value="">{tr(c.allIndustries, lang)}</option>
            {industries.map((industry) => <option value={industry.id}>{tr(industry.data.name, lang)}</option>)}
          </select>
        </div>
      </form>

      <p class="count js-only" role="status" data-count data-template={tr(c.count, lang)}>
        {fill(c.count, lang, { n: systems.length })}
      </p>

      {
        GROUP_ORDER.map((group) => (
          <section class="group" data-group-section={group}>
            <div class="group-head">
              <h2>{tr(c.groups[group].name, lang)}</h2>
              <p>{tr(c.groups[group].intro, lang)}</p>
            </div>
            <SystemsTable lang={lang} systems={systems.filter((s) => s.data.group === group)} filterable reveal={false} />
          </section>
        ))
      }
      <p class="empty" data-empty hidden>{tr(c.empty, lang)}</p>

      <div class="legend">
        <h2>{tr(c.legendTitle, lang)}</h2>
        <dl>
          {
            statuses.map((status) => (
              <div>
                <dt>{tr(ui.status[status], lang)}</dt>
                <dd>{tr(c.legend[status], lang)}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <FinalCta lang={lang} title={home.final.title} body={home.final.body} design />
</BaseLayout>

<style>
  .list .wrap {
    padding-bottom: var(--space-section);
  }
  .filters {
    display: grid;
    grid-template-columns: 1fr minmax(12rem, 18rem);
    gap: 1.25rem 2rem;
    align-items: end;
    padding-block: 1.5rem;
    border-block: 1px solid var(--line);
  }
  /* Search and field share the first row; the group choices take the whole second row. */
  fieldset.field {
    grid-column: 1 / -1;
    grid-row: 2;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  label,
  legend {
    padding: 0;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--muted);
  }
  legend {
    margin-bottom: 0.4rem;
  }
  input[type='search'],
  select {
    width: 100%;
    min-height: 3rem;
    padding: 0.5rem 0.8rem;
    border: 1px solid var(--line-strong);
    border-radius: 0;
    background: var(--bg);
    color: var(--ink);
    font: inherit;
    font-size: var(--text-md);
  }
  input[type='search']::placeholder {
    color: var(--muted);
    opacity: 1;
  }
  .segments {
    display: flex;
    flex-wrap: wrap;
  }
  .segments label {
    position: relative;
    display: inline-flex;
    margin-inline-end: -1px;
    margin-bottom: -1px;
  }
  .segments input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .segments span {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--line-strong);
    font-size: var(--text-md);
    font-weight: 500;
    color: var(--ink);
    transition:
      background-color var(--fast) ease,
      color var(--fast) ease;
  }
  .segments input:hover + span {
    background: var(--soft);
  }
  .segments input:checked + span {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }
  .segments input:focus-visible + span {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
  .count {
    margin-top: 1rem;
    font-size: var(--text-sm);
    color: var(--muted);
  }
  .group {
    padding-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }
  .group-head {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }
  .group-head h2 {
    font-size: var(--text-h3);
  }
  .group-head p {
    color: var(--muted);
    max-width: 56ch;
  }
  .empty {
    padding-block: 3rem;
    font-size: var(--text-lead);
    color: var(--muted);
  }
  .legend {
    margin-top: clamp(3rem, 2rem + 3vw, 4.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: var(--text-md);
  }
  .legend h2 {
    font-family: inherit;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--muted);
    margin-bottom: 0.6rem;
  }
  .legend dl {
    display: grid;
    gap: 0.35rem;
    margin: 0;
  }
  .legend dl div {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1rem;
  }
  .legend dt {
    font-weight: 500;
  }
  .legend dd {
    margin: 0;
    color: var(--muted);
  }
  @media (max-width: 62rem) {
    .filters {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 30rem) {
    .legend dl div {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>

<script>
  /** Search and filter the list of systems. Without scripts the full list is simply shown. */
  import { track } from '@/scripts/track';

  const form = document.querySelector<HTMLFormElement>('[data-filters]');
  const rows = [...document.querySelectorAll<HTMLElement>('[data-system]')];
  const sections = [...document.querySelectorAll<HTMLElement>('[data-group-section]')];
  const count = document.querySelector<HTMLElement>('[data-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  if (form && rows.length > 0) {
    const search = form.querySelector<HTMLInputElement>('input[name="q"]');
    const industry = form.querySelector<HTMLSelectElement>('select[name="industry"]');
    const groupValue = (): string => form.querySelector<HTMLInputElement>('input[name="group"]:checked')?.value ?? '';

    const apply = (): void => {
      const words = (search?.value ?? '').trim().toLowerCase().split(/\s+/).filter(Boolean);
      const group = groupValue();
      const field = industry?.value ?? '';
      let shown = 0;
      for (const row of rows) {
        const text = row.dataset['search'] ?? '';
        const match =
          words.every((word) => text.includes(word)) &&
          (group === '' || row.dataset['group'] === group) &&
          (field === '' || (row.dataset['industries'] ?? '').split(' ').includes(field));
        row.hidden = !match;
        if (match) shown++;
      }
      for (const section of sections) section.hidden = section.querySelectorAll('[data-system]:not([hidden])').length === 0;
      if (count) count.textContent = (count.dataset['template'] ?? '{n}').replace('{n}', String(shown));
      if (empty) empty.hidden = shown !== 0;
    };

    // A link such as /solutions/?industry=umrah opens the list already filtered.
    const params = new URLSearchParams(window.location.search);
    const wantedField = params.get('industry');
    if (industry && wantedField && [...industry.options].some((o) => o.value === wantedField)) industry.value = wantedField;
    const wantedGroup = params.get('group');
    const radio = wantedGroup ? form.querySelector<HTMLInputElement>(`input[name="group"][value="${CSS.escape(wantedGroup)}"]`) : null;
    if (radio) radio.checked = true;
    if (search && params.get('q')) search.value = params.get('q') ?? '';

    form.addEventListener('submit', (event) => event.preventDefault());
    form.addEventListener('input', apply);
    form.addEventListener('change', () => {
      apply();
      // Counted without the search words: only which filter was used.
      track('solutions-filter', { group: groupValue() || 'all', field: industry?.value || 'all' });
    });
    apply();
  }
</script>
