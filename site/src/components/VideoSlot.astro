---
/**
 * The 2-minute demo video. Nothing from YouTube loads until the visitor presses play, and it then
 * plays from YouTube's privacy mode. The whole block is left out while settings.videoId is empty.
 */
import Icon from './Icon.astro';
import { ui, tr, settings, type Lang } from '@/lib/i18n';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const id = settings.videoId;
if (id !== '' && !/^[\w-]{11}$/.test(id)) {
  throw new Error(`settings.videoId must be the 11-character YouTube video id, got "${id}"`);
}
---

{
  id !== '' && (
    <div class="video" id="demo-video" data-video={id} data-title={tr(ui.video.frameTitle, lang)}>
      <button type="button" class="poster" data-video-play aria-label={tr(ui.video.play, lang)}>
        <span class="play">
          <Icon name="play" />
        </span>
        <span class="label">{tr(ui.video.watch, lang)}</span>
      </button>
      <noscript>
        <a class="text-link" href={`https://www.youtube.com/watch?v=${id}`}>{tr(ui.video.watch, lang)}</a>
      </noscript>
      <p class="note">{tr(ui.video.note, lang)}</p>
    </div>
  )
}

<style>
  .video {
    max-width: 56rem;
    margin-inline: auto;
  }
  .poster,
  .video :global(iframe) {
    display: flex;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--line);
  }
  .poster {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background: var(--soft);
    cursor: pointer;
    transition: border-color var(--fast) ease;
  }
  .poster:hover {
    border-color: var(--ink);
  }
  .play {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: var(--teal);
    color: var(--on-teal);
  }
  .play :global(svg) {
    width: 2rem;
    height: 2rem;
  }
  .label {
    font-family: var(--font-serif);
    font-size: var(--text-h3);
  }
  .label:lang(ar) {
    font-family: var(--font-arabic);
    font-weight: 500;
  }
  .note {
    margin-top: 0.6rem;
    font-size: var(--text-sm);
    color: var(--muted);
  }
</style>

<script>
  import { track } from '@/scripts/track';

  document.querySelectorAll<HTMLElement>('[data-video]').forEach((block) => {
    const id = block.dataset['video'] ?? '';
    const button = block.querySelector<HTMLButtonElement>('[data-video-play]');
    if (!button || !/^[\w-]{11}$/.test(id)) return;
    button.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      frame.title = block.dataset['title'] ?? '';
      frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      frame.referrerPolicy = 'strict-origin-when-cross-origin';
      button.replaceWith(frame);
      frame.focus();
      track('video-play');
    });
  });
</script>
