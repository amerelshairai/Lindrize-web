---
/**
 * Pages change instantly with no transition (SPEC 8). If the next page takes longer than 0.3 s,
 * a thin bar shows that it is loading. If the visitor is offline, a short message says so.
 */
import { ui, tr, type Lang } from '@/lib/i18n';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<div class="load-bar" data-load-bar aria-hidden="true"></div>
<div class="offline" data-offline role="status" hidden>
  <span>{tr(ui.offline.message, lang)}</span>
  <button type="button" class="btn btn-alt btn-sm" data-offline-retry>{tr(ui.offline.retry, lang)}</button>
</div>

<style>
  .load-bar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 60;
    height: 3px;
    background: var(--teal);
    transform: scaleX(0);
    transform-origin: left center;
    opacity: 0;
    pointer-events: none;
  }
  :global([dir='rtl']) .load-bar {
    transform-origin: right center;
  }
  .load-bar[data-active] {
    opacity: 1;
    transform: scaleX(0.85);
    transition: transform 8s cubic-bezier(0.1, 0.6, 0.2, 1);
  }
  .offline {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 55;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding: 0.85rem max(var(--gutter), env(safe-area-inset-right, 0px)) calc(0.85rem + env(safe-area-inset-bottom, 0px))
      max(var(--gutter), env(safe-area-inset-left, 0px));
    background: var(--soft);
    border-top: 1px solid var(--line-strong);
    font-size: var(--text-md);
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-load-bar]');
  const offline = document.querySelector<HTMLElement>('[data-offline]');
  const retry = document.querySelector<HTMLButtonElement>('[data-offline-retry]');
  let timer: number | undefined;
  let pending: string | undefined;

  const reset = (): void => {
    window.clearTimeout(timer);
    bar?.removeAttribute('data-active');
  };
  const go = (href: string): void => {
    if (!navigator.onLine) {
      pending = href;
      offline?.removeAttribute('hidden');
      return;
    }
    offline?.setAttribute('hidden', '');
    pending = undefined;
    reset();
    timer = window.setTimeout(() => bar?.setAttribute('data-active', ''), 300);
    window.location.assign(href);
  };

  document.addEventListener('click', (event) => {
    if (event.defaultPrevented || event.button !== 0) return;
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const link = (event.target as Element).closest<HTMLAnchorElement>('a[href]');
    if (!link || link.target === '_blank' || link.hasAttribute('download')) return;
    const url = new URL(link.href, window.location.href);
    if (url.origin !== window.location.origin) return;
    // Links to a place on this same page just scroll.
    if (url.pathname === window.location.pathname && url.search === window.location.search) return;
    event.preventDefault();
    go(url.href);
  });

  retry?.addEventListener('click', () => {
    if (pending) go(pending);
    else if (navigator.onLine) offline?.setAttribute('hidden', '');
  });
  window.addEventListener('online', () => {
    if (pending) go(pending);
    else offline?.setAttribute('hidden', '');
  });
  window.addEventListener('offline', () => offline?.removeAttribute('hidden'));
  // Coming back with the browser's Back button must not leave the bar showing.
  window.addEventListener('pageshow', reset);
</script>
