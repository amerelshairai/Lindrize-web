---
/**
 * The booking calendar, shown in a dialog over the page.
 *
 * Calendly's page is loaded in a frame only after the visitor clicks a booking button. We do not
 * load Calendly's script into our own pages, so it can never read or change anything on this site.
 */
import Icon from './Icon.astro';
import { ui, tr, settings, type Lang } from '@/lib/i18n';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<dialog class="book" id="book-dialog" aria-labelledby="book-title" data-frame-title={tr(ui.book.frameTitle, lang)}>
  <div class="bar">
    <h2 id="book-title">{tr(ui.book.dialogTitle, lang)}</h2>
    <button type="button" class="icon-btn" data-book-close aria-label={tr(ui.book.close, lang)}>
      <Icon name="close" />
    </button>
  </div>
  <div class="frame" data-book-frame>
    <p class="loading" data-book-loading>{tr(ui.book.loading, lang)}</p>
  </div>
  <p class="alt">
    <a class="text-link" href={settings.calendlyUrl} target="_blank" rel="noopener" data-book-newtab data-astro-prefetch="false">
      {tr(ui.book.newTab, lang)}
    </a>
  </p>
</dialog>

<style>
  .book {
    width: min(100vw - 2rem, 62rem);
    height: min(100dvh - 2rem, 46rem);
    max-width: none;
    max-height: none;
    padding: 0;
    border: 1px solid var(--line-strong);
    background: var(--bg);
    color: var(--ink);
  }
  .book[open] {
    display: flex;
    flex-direction: column;
  }
  .book::backdrop {
    background: rgb(30 28 27 / 0.6);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0.5rem 0.5rem 1.25rem;
    padding-inline: 1.25rem 0.5rem;
    border-bottom: 1px solid var(--line);
  }
  h2 {
    font-size: 1.25rem;
  }
  .frame {
    position: relative;
    flex: 1;
    min-height: 0;
    background: var(--soft);
  }
  .frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    /* Calendly's page is light. Keep the frame light so it never shows dark-on-dark. */
    background: #fff;
    color-scheme: light;
  }
  .loading {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--muted);
  }
  .alt {
    padding: 0.6rem 1.25rem;
    border-top: 1px solid var(--line);
    font-size: var(--text-sm);
  }
  @media (max-width: 40rem) {
    .book {
      width: 100vw;
      height: 100dvh;
      border: 0;
    }
  }
  :global(html.dialog-open) {
    overflow: hidden;
  }
</style>

<script>
  import { track } from '@/scripts/track';

  const dialog = document.querySelector<HTMLDialogElement>('#book-dialog');
  const holder = dialog?.querySelector<HTMLElement>('[data-book-frame]');
  const loading = dialog?.querySelector<HTMLElement>('[data-book-loading]');
  const newTab = dialog?.querySelector<HTMLAnchorElement>('[data-book-newtab]');
  const CALENDLY = 'calendly.com';

  if (dialog && holder && typeof dialog.showModal === 'function') {
    const open = (href: string, source: string, prefill: string | undefined): void => {
      let url: URL;
      try {
        url = new URL(href);
      } catch {
        return;
      }
      // Only ever frame Calendly. Anything else is opened as a normal link.
      if (url.protocol !== 'https:' || url.hostname !== CALENDLY) {
        window.location.assign(href);
        return;
      }
      // The design summary from "Design your agent" fills Calendly's first custom question.
      if (prefill) url.searchParams.set('a1', prefill);
      if (newTab) newTab.href = url.href;
      url.searchParams.set('embed_domain', window.location.hostname);
      url.searchParams.set('embed_type', 'PopupWidget');

      const frame = document.createElement('iframe');
      frame.title = dialog.dataset['frameTitle'] ?? '';
      frame.referrerPolicy = 'strict-origin-when-cross-origin';
      frame.addEventListener('load', () => loading?.setAttribute('hidden', ''));
      frame.src = url.href;
      holder.querySelector('iframe')?.remove();
      loading?.removeAttribute('hidden');
      holder.append(frame);

      dialog.showModal();
      document.documentElement.classList.add('dialog-open');
      document.dispatchEvent(new CustomEvent('lz:book-open'));
      track('book-open', { from: source });
    };

    document.addEventListener('click', (event) => {
      if (event.defaultPrevented || event.button !== 0) return;
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const link = (event.target as Element).closest<HTMLAnchorElement>('a[data-book]');
      if (!link) return;
      event.preventDefault();
      open(link.href, link.dataset['bookSource'] ?? window.location.pathname, link.dataset['bookPrefill']);
    });

    dialog.querySelector('[data-book-close]')?.addEventListener('click', () => dialog.close());
    // A click on the dimmed area outside the dialog closes it.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      holder.querySelector('iframe')?.remove();
      document.documentElement.classList.remove('dialog-open');
      document.dispatchEvent(new CustomEvent('lz:book-close'));
    });

    // Calendly tells the page when a booking is completed. We only count it; no details are read.
    window.addEventListener('message', (event) => {
      if (event.origin !== `https://${CALENDLY}`) return;
      const data = event.data as { event?: unknown } | null;
      if (data && data.event === 'calendly.event_scheduled') track('book-scheduled');
    });
  }
</script>
