---
import { ui, tr, otherLang, localPath, type Lang } from '@/lib/i18n';
interface Props {
  lang: Lang;
  /** The current page's path without a language prefix, for example "/pricing/". */
  page: string;
}
const { lang, page } = Astro.props;
const target = otherLang(lang);
---

<a class="lang-switch" href={localPath(target, page)} lang={target} hreflang={target} aria-label={tr(ui.lang.switchLabel, lang)}>
  {tr(ui.lang.switchTo, lang)}
</a>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.6rem;
    font-size: var(--text-md);
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--fast) ease;
  }
  .lang-switch:hover {
    color: var(--ink);
    text-decoration: underline;
  }
</style>
