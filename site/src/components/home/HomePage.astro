---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import Hero from './Hero.astro';
import StoryScroll from './StoryScroll.astro';
import TryItYourself from './TryItYourself.astro';
import Statement from './Statement.astro';
import SystemsTable from './SystemsTable.astro';
import WorkingWithUs from './WorkingWithUs.astro';
import FeedbackSection from './FeedbackSection.astro';
import FaqList from './FaqList.astro';
import FinalCta from './FinalCta.astro';
import { tr, localPath, ROUTES, type Lang } from '@/lib/i18n';
import { getSystem } from '@/lib/content';
import { faqPage } from '@/lib/schema';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const page = await getEntry('home', 'home');
if (!page) throw new Error('src/content/pages/home.yaml is missing');
const c = page.data;

const chats = (await getCollection('chats')).sort((a, b) => a.data.order - b.data.order);
const [mainChat, ...sampleChats] = chats;
if (!mainChat) throw new Error('At least one demo chat is needed in src/content/chats');

const featured = await Promise.all(c.systems.featured.map((number) => getSystem(number)));

const homeFaqs = (await getCollection('faqs'))
  .filter((faq) => faq.data.home !== undefined)
  .sort((a, b) => (a.data.home ?? 0) - (b.data.home ?? 0));
---

<BaseLayout
  lang={lang}
  title={tr(c.seo.title, lang)}
  description={tr(c.seo.description, lang)}
  page={ROUTES.home}
  schema={[faqPage(lang, homeFaqs.map((faq) => faq.data))]}
>
  <Hero lang={lang} content={c.hero} chat={mainChat.data} />

  <section class="sec" id="how">
    <div class="wrap">
      <div class="sec-head">
        <div class="drawline" data-draw></div>
        <h2 data-reveal>{tr(c.story.title, lang)}</h2>
      </div>
      <StoryScroll lang={lang} content={c.story} chat={mainChat.data} />
      <TryItYourself lang={lang} content={c.tryIt} chats={sampleChats} />
    </div>
  </section>

  <Statement lang={lang} text={c.statement} />

  <section class="sec" id="systems">
    <div class="wrap">
      <div class="sec-head">
        <div class="drawline" data-draw></div>
        <h2 data-reveal>{tr(c.systems.title, lang)}</h2>
        <p data-reveal>{tr(c.systems.body, lang)}</p>
      </div>
      <SystemsTable lang={lang} systems={featured} />
      <p class="more" data-reveal>
        <Button href={localPath(lang, ROUTES.solutions)} variant="alt" arrow>{tr(c.systems.all, lang)}</Button>
      </p>
    </div>
  </section>

  <section class="sec" id="working">
    <div class="wrap">
      <div class="sec-head">
        <div class="drawline" data-draw></div>
        <h2 data-reveal>{tr(c.working.title, lang)}</h2>
        <p data-reveal>{tr(c.working.body, lang)}</p>
      </div>
      <WorkingWithUs lang={lang} steps={c.working.steps} />
    </div>
  </section>

  <FeedbackSection lang={lang} title={c.feedback.title} />

  <section class="sec" id="faq">
    <div class="wrap">
      <div class="sec-head">
        <div class="drawline" data-draw></div>
        <h2 data-reveal>{tr(c.faq.title, lang)}</h2>
      </div>
      <FaqList lang={lang} items={homeFaqs.map((faq) => faq.data)} />
      <p class="more" data-reveal>
        <Button href={localPath(lang, ROUTES.faq)} variant="alt" arrow>{tr(c.faq.all, lang)}</Button>
      </p>
    </div>
  </section>

  <FinalCta lang={lang} title={c.final.title} body={c.final.body} />
</BaseLayout>

<style>
  .more {
    padding-block: 1.75rem var(--space-section);
  }
</style>

<script>
  import '@/scripts/motion';
</script>
