---
/** One sentence that lights up word by word as the visitor scrolls through it. */
import { tr, type Lang, type Text } from '@/lib/i18n';
interface Props {
  lang: Lang;
  text: Text;
}
const { lang, text } = Astro.props;
const words = tr(text, lang).split(' ');
---

<section class="sec statement">
  <div class="wrap">
    <p data-statement>{words.map((word, i) => <><span class="word">{word}</span>{i < words.length - 1 ? ' ' : ''}</>)}</p>
  </div>
</section>

<style>
  .wrap {
    padding-block: clamp(5rem, 3rem + 8vw, 8.5rem);
  }
  p {
    max-width: 26ch;
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 1.2rem + 2.4vw, 2.75rem);
    line-height: 1.3;
    text-wrap: balance;
  }
  p:lang(ar) {
    font-family: var(--font-arabic);
    font-weight: 500;
    line-height: 1.6;
  }
  .word {
    transition: color 200ms ease;
  }
  /* Unlit words stay readable (3:1 or better for this large text). */
  p:global([data-armed]) .word {
    color: var(--line-strong);
  }
  p:global([data-armed]) .word:global(.lit) {
    color: var(--ink);
  }
</style>
