---
import type { CollectionEntry } from 'astro:content';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import ChatPhone from '@/components/ChatPhone.astro';
import VideoSlot from '@/components/VideoSlot.astro';
import { ui, tr, settings, localPath, splitAt, ROUTES, type Lang } from '@/lib/i18n';

interface Props {
  lang: Lang;
  content: CollectionEntry<'home'>['data']['hero'];
  chat: CollectionEntry<'chats'>['data'];
}
const { lang, content, chat } = Astro.props;
const words = tr(content.title, lang).split(' ');
const [tryBefore, tryAfter] = splitAt(tr(content.tryLine, lang), 'handle');
const hasVideo = settings.videoId !== '';
---

<section class="hero">
  <div class="wrap grid">
    <div class="copy">
      <h1>{words.map((word, i) => <><span class="w">{word}</span>{i < words.length - 1 ? ' ' : ''}</>)}</h1>
      <p class="lead">{tr(content.lead, lang)}</p>
      <div class="actions">
        <Button href={settings.calendlyUrl} book arrow data-hero-cta data-book-source="hero">{tr(ui.book.long, lang)}</Button>
        <Button href={localPath(lang, ROUTES.design)} variant="alt">{tr(ui.design.cta, lang)}</Button>
      </div>
      <p class="try">
        {tryBefore}<a class="text-link ltr" href={settings.demo.profileUrl} target="_blank" rel="noopener" data-astro-prefetch="false" data-track="demo">@{settings.demo.handle}</a>{tryAfter}
      </p>
      {
        hasVideo && (
          <p class="watch">
            <a class="text-link" href="#demo-video">
              {tr(ui.video.watch, lang)}
            </a>
          </p>
        )
      }
    </div>
    <div class="visual">
      <div id="hero-chat">
        <ChatPhone chat={chat} lang={lang} to={4} autoplay />
      </div>
      <button type="button" class="replay js-only motion-only" data-chat-replay="hero-chat">
        <Icon name="replay" />
        {tr(ui.chat.replay, lang)}
      </button>
    </div>
  </div>
  {hasVideo && <div class="wrap video"><VideoSlot lang={lang} /></div>}
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    padding-block: clamp(2.5rem, 2rem + 4vw, 5rem) clamp(3rem, 2rem + 4vw, 5.5rem);
  }
  .copy {
    border-top: 1px solid var(--ink);
    padding-top: 1.75rem;
  }
  h1 {
    margin-bottom: 1.5rem;
    max-width: 14ch;
  }
  h1:lang(ar) {
    max-width: 16ch;
  }
  .lead {
    max-width: 46ch;
    margin-bottom: 2rem;
    font-size: var(--text-lead);
    color: var(--muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .try,
  .watch {
    margin-top: 1.25rem;
    max-width: 46ch;
    font-size: var(--text-md);
    color: var(--muted);
  }
  .watch {
    margin-top: 0.5rem;
  }
  .visual {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  #hero-chat {
    width: 100%;
    max-width: 24rem;
    filter: drop-shadow(0 18px 28px rgb(51 48 45 / 0.08));
  }
  .replay {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    border: 0;
    background: transparent;
    font-size: var(--text-sm);
    color: var(--muted);
    cursor: pointer;
    transition: color var(--fast) ease;
  }
  .replay:hover {
    color: var(--ink);
  }
  .replay :global(svg) {
    width: 1rem;
    height: 1rem;
  }
  .video {
    padding-bottom: clamp(3rem, 2rem + 4vw, 5.5rem);
  }

  /* Headline words rise into place on load, finishing in under a second. */
  @keyframes word-rise {
    from {
      opacity: 0;
      transform: translateY(0.3em);
    }
  }
  :global(html.motion) h1 .w {
    display: inline-block;
    animation: word-rise 520ms var(--ease) both;
  }
  :global(html.motion) h1 .w:nth-child(2) { animation-delay: 40ms; }
  :global(html.motion) h1 .w:nth-child(3) { animation-delay: 80ms; }
  :global(html.motion) h1 .w:nth-child(4) { animation-delay: 120ms; }
  :global(html.motion) h1 .w:nth-child(5) { animation-delay: 160ms; }
  :global(html.motion) h1 .w:nth-child(6) { animation-delay: 200ms; }
  :global(html.motion) h1 .w:nth-child(7) { animation-delay: 240ms; }
  :global(html.motion) h1 .w:nth-child(8) { animation-delay: 280ms; }
  :global(html.motion) h1 .w:nth-child(9) { animation-delay: 320ms; }
  :global(html.motion) h1 .w:nth-child(n + 10) { animation-delay: 360ms; }

  @media (max-width: 56rem) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  /* On phones the two buttons are always stacked, so a font arriving can never re-wrap them
     and push the page down. */
  @media (max-width: 30rem) {
    .actions {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
