---
/** Questions and answers, always fully visible (never folded away). */
import type { CollectionEntry } from 'astro:content';
import { tr, type Lang } from '@/lib/i18n';
interface Props {
  lang: Lang;
  items: Array<CollectionEntry<'faqs'>>;
}
const { lang, items } = Astro.props;
---

<div class="faq" data-reveal-group>
  {
    items.map((item) => (
      <div class="item" data-reveal>
        <h3>{tr(item.data.question, lang)}</h3>
        <p>{tr(item.data.answer, lang)}</p>
      </div>
    ))
  }
</div>

<style>
  .faq {
    border-top: 1px solid var(--ink);
  }
  .item {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 0.5rem 2.5rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--line);
  }
  h3 {
    font-size: 1.375rem;
    line-height: 1.3;
  }
  p {
    max-width: 58ch;
    color: var(--muted);
  }
  @media (max-width: 48rem) {
    .item {
      grid-template-columns: 1fr;
    }
  }
</style>
