---
/** The four steps of working with Lindrize. A line fills down through them as the visitor scrolls. */
import type { CollectionEntry } from 'astro:content';
import { tr, type Lang } from '@/lib/i18n';
interface Props {
  lang: Lang;
  steps: CollectionEntry<'pages'>['data']['working']['steps'];
}
const { lang, steps } = Astro.props;
---

<ol class="process" role="list" data-process>
  <li class="track" aria-hidden="true"><span class="fill" data-process-fill></span></li>
  {
    steps.map((step) => (
      <li class="pstep" data-process-step>
        <div>
          <h3>{tr(step.title, lang)}</h3>
          <span class="note">{tr(step.note, lang)}</span>
        </div>
        <p>{tr(step.body, lang)}</p>
      </li>
    ))
  }
</ol>

<style>
  .process {
    position: relative;
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    padding-inline-start: 2.5rem;
    padding-bottom: var(--space-section);
    list-style: none;
  }
  .track {
    position: absolute;
    inset-inline-start: 0.4rem;
    top: 1.6rem;
    bottom: calc(var(--space-section) + 2rem);
    width: 1px;
    background: var(--line);
  }
  .fill {
    position: absolute;
    inset: 0 0 auto 0;
    height: 0;
    background: var(--ink);
  }
  .pstep {
    position: relative;
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: 0.5rem 1.5rem;
    padding-block: 1.1rem 1.9rem;
  }
  .pstep::before {
    content: '';
    position: absolute;
    inset-inline-start: -2.5rem;
    top: 1.6rem;
    width: 0.8125rem;
    height: 0.8125rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--bg);
    transition:
      background-color 250ms ease,
      border-color 250ms ease;
  }
  .pstep:global(.reached)::before {
    background: var(--ink);
    border-color: var(--ink);
  }
  h3 {
    font-size: 1.5rem;
    line-height: 1.25;
  }
  .note {
    display: block;
    margin-top: 0.25rem;
    font-size: var(--text-sm);
    color: var(--muted);
  }
  p {
    max-width: 52ch;
    color: var(--muted);
  }
  @media (max-width: 48rem) {
    .pstep {
      grid-template-columns: 1fr;
    }
  }
</style>
