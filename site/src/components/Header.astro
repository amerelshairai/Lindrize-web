---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import Button from './Button.astro';
import LangSwitch from './LangSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';
import WhatsAppLink from './WhatsAppLink.astro';
import { ui, tr, settings, localPath, ROUTES, type Lang } from '@/lib/i18n';

interface Props {
  lang: Lang;
  page: string;
}
const { lang, page } = Astro.props;
const links = [
  { route: ROUTES.solutions, label: ui.nav.solutions },
  { route: ROUTES.industries, label: ui.nav.industries },
  { route: ROUTES.pricing, label: ui.nav.pricing },
  { route: ROUTES.design, label: ui.nav.design },
];
const isCurrent = (route: string): boolean => page === route || (route !== '/' && page.startsWith(route));
---

<header class="site-head" data-site-head>
  <div class="wrap row">
    <a class="home" href={localPath(lang, ROUTES.home)} aria-label={tr(ui.nav.home, lang)}>
      <Logo />
    </a>

    <nav class="nav" id="site-nav" aria-label={tr(ui.nav.label, lang)} data-nav>
      <ul role="list">
        {
          links.map(({ route, label }) => (
            <li>
              <a href={localPath(lang, route)} aria-current={isCurrent(route) ? 'page' : undefined}>
                {tr(label, lang)}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="nav-extra">
        <WhatsAppLink lang={lang} />
        <Button href={settings.calendlyUrl} book arrow>{tr(ui.book.long, lang)}</Button>
      </div>
    </nav>

    <div class="tools">
      <LangSwitch lang={lang} page={page} />
      <ThemeToggle lang={lang} />
      <WhatsAppLink lang={lang} variant="icon" class="wide-only" />
      <Button href={settings.calendlyUrl} book size="sm" class="wide-only">{tr(ui.book.short, lang)}</Button>
      <button
        type="button"
        class="icon-btn menu-btn js-only"
        aria-controls="site-nav"
        aria-expanded="false"
        data-nav-toggle
        data-label-open={tr(ui.nav.menu, lang)}
        data-label-close={tr(ui.nav.closeMenu, lang)}
        aria-label={tr(ui.nav.menu, lang)}
      >
        <span class="when-closed"><Icon name="menu" /></span>
        <span class="when-open"><Icon name="close" /></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-head {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    padding-top: env(safe-area-inset-top, 0px);
  }
  .row {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    min-height: var(--header-h);
  }
  .home {
    display: block;
    flex: none;
  }
  .nav {
    margin-inline-start: auto;
  }
  .nav ul {
    display: flex;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav a:not(.btn) {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: var(--text-md);
    color: var(--muted);
    text-decoration: none;
    transition: color var(--fast) ease;
  }
  .nav ul a:hover,
  .nav ul a[aria-current='page'] {
    color: var(--ink);
  }
  .nav ul a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 0.5em;
  }
  .nav-extra {
    display: none;
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex: none;
  }
  .tools :global(.btn) {
    margin-inline-start: 0.5rem;
  }
  .menu-btn {
    display: none;
  }
  .menu-btn span {
    display: grid;
  }
  .menu-btn .when-open,
  .menu-btn[aria-expanded='true'] .when-closed {
    display: none;
  }
  .menu-btn[aria-expanded='true'] .when-open {
    display: grid;
  }

  @media (max-width: 62rem) {
    .row {
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    .tools {
      margin-inline-start: auto;
    }
    .tools :global(.wide-only) {
      display: none;
    }
    .menu-btn {
      display: inline-grid;
    }
    .nav {
      order: 3;
      flex-basis: 100%;
      margin: 0;
      padding-block: 0.5rem 1.25rem;
      border-top: 1px solid var(--line);
    }
    /* With scripts on, the menu opens from the menu button. Without scripts it is simply shown. */
    :global(html.js) .nav:not([data-open]) {
      display: none;
    }
    .nav ul {
      flex-direction: column;
      gap: 0;
    }
    .nav ul a {
      width: 100%;
      min-height: 3rem;
      font-size: var(--text-body);
      color: var(--ink);
      border-bottom: 1px solid var(--line);
    }
    .nav-extra {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
      padding-top: 1rem;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (toggle && nav) {
    const set = (open: boolean): void => {
      nav.toggleAttribute('data-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      const label = open ? toggle.dataset['labelClose'] : toggle.dataset['labelOpen'];
      if (label) toggle.setAttribute('aria-label', label);
    };
    const isOpen = (): boolean => nav.hasAttribute('data-open');
    toggle.addEventListener('click', () => set(!isOpen()));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        set(false);
        toggle.focus();
      }
    });
    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (isOpen() && !nav.contains(target) && !toggle.contains(target)) set(false);
    });
    nav.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) set(false);
    });
    window.matchMedia('(min-width: 62.01rem)').addEventListener('change', () => set(false));
  }
</script>
