---
/** Small line icons. Decorative by default: the control that holds them carries the label. */
interface Props {
  name: 'arrow' | 'whatsapp' | 'sun' | 'moon' | 'menu' | 'close' | 'play' | 'replay' | 'instagram';
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg
  class:list={[name === 'arrow' && 'arrow', className]}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'arrow' && <path d="M4 12h15M13 6l6 6-6 6" />}
  {
    name === 'whatsapp' && (
      <>
        <path d="M3.5 20.5l1.2-4.3A8.5 8.5 0 1 1 8 19.4z" />
        <path d="M9 8.6c-.3 1 .4 2.6 1.8 4s3 2.1 4 1.8l.9-1.2-1.9-1-.8.8c-.6-.2-1.6-1.2-1.8-1.8l.8-.8-1-1.9z" />
      </>
    )
  }
  {
    name === 'sun' && (
      <>
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
      </>
    )
  }
  {name === 'moon' && <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6L6 18" />}
  {name === 'play' && <path d="M8 5.5v13l11-6.5z" fill="currentColor" stroke="none" />}
  {
    name === 'replay' && (
      <>
        <path d="M4 12a8 8 0 1 0 2.6-5.9" />
        <path d="M4 4v4.5h4.5" />
      </>
    )
  }
  {
    name === 'instagram' && (
      <>
        <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" />
        <circle cx="12" cy="12" r="3.8" />
        <circle cx="17" cy="7" r=".6" fill="currentColor" />
      </>
    )
  }
</svg>
