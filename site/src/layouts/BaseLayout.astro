---
import { Font } from 'astro:assets';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import MobileStickyBar from '@/components/MobileStickyBar.astro';
import BookDialog from '@/components/BookDialog.astro';
import PageLoadBar from '@/components/PageLoadBar.astro';
import { ui, tr, dirOf, localPath, absoluteUrl, settings, type Lang } from '@/lib/i18n';
import { organization, website, webPage, toJsonLd } from '@/lib/schema';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** The page's path without a language prefix, for example "/" or "/pricing/". */
  page: string;
  /** Keep this page out of search engines (unfinished pages, the 404 page). */
  noindex?: boolean;
  /** Hide the phone booking bar, for example inside "Design your agent". */
  hideStickyBar?: boolean;
  whatsappMessage?: string | undefined;
  /** Extra structured data for this page (breadcrumbs, FAQ, service). */
  schema?: Array<Record<string, unknown>>;
}
const { lang, title, description, page, noindex = false, hideStickyBar = false, whatsappMessage, schema = [] } = Astro.props;
const canonical = absoluteUrl(localPath(lang, page));
const ogImage = absoluteUrl('/og-image.png');
const jsonLd = toJsonLd([organization(), website(), webPage(lang, page, title, description), ...schema]);
---

<!doctype html>
<html lang={lang} dir={dirOf(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') d.setAttribute('data-theme', t);
        } catch (e) {}
        if (window.matchMedia && matchMedia('(prefers-reduced-motion: no-preference)').matches) d.classList.add('motion');
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      !noindex && (
        <>
          <link rel="canonical" href={canonical} />
          <link rel="alternate" hreflang="en" href={absoluteUrl(localPath('en', page))} />
          <link rel="alternate" hreflang="ar" href={absoluteUrl(localPath('ar', page))} />
          <link rel="alternate" hreflang="x-default" href={absoluteUrl(localPath('en', page))} />
        </>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={settings.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_AR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'ar' ? 'en_US' : 'ar_AR'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Lindrize: AI sales assistants for travel agencies" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#2a2826" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <meta name="format-detection" content="telephone=no" />

    {/* Fonts used at the top of the page are fetched early, so text does not move when they arrive. */}
    {/* Cookie-free visitor counting (Umami on our own server). Off until the id is set in Settings.
        Only visits to the real address are counted, never the test address. */}
    {settings.umamiWebsiteId !== '' && <script is:inline defer src="/u/script.js" data-website-id={settings.umamiWebsiteId} data-domains={new URL(settings.siteUrl).hostname} data-do-not-track="true" />}
    {!noindex && <script type="application/ld+json" is:inline set:html={jsonLd} />}

    <Font cssVariable="--font-plex-serif" preload={lang === 'en'} />
    <Font cssVariable="--font-plex-sans" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-plex-arabic" preload={lang === 'ar' ? true : [{ weight: 400 }]} />
  </head>
  <body>
    <a class="skip" href="#main">{tr(ui.skip, lang)}</a>
    <Header lang={lang} page={page} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    {!hideStickyBar && <MobileStickyBar lang={lang} whatsappMessage={whatsappMessage} />}
    <BookDialog lang={lang} />
    <PageLoadBar lang={lang} />
  </body>
</html>

<script>
  // Count presses of the buttons marked with data-track (WhatsApp, the demo). No names, no text.
  import { track } from '@/scripts/track';
  document.addEventListener('click', (event) => {
    const marked = (event.target as Element).closest<HTMLElement>('[data-track]');
    if (marked?.dataset['track']) track(marked.dataset['track'], { page: window.location.pathname });
  });
</script>

<style is:global>
  main:focus {
    outline: none;
  }
</style>
