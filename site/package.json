{
  "name": "lindrize-site",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "check:content": "node scripts/check-content.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check": "astro check && astro build && node scripts/check-content.mjs && node scripts/check-links.mjs && node scripts/catalog.mjs --check && node scripts/pages-cms.mjs --check && node scripts/contrast.mjs",
    "test": "playwright test",
    "lighthouse": "node scripts/lighthouse.mjs",
    "serve": "node scripts/serve.mjs",
    "catalog": "node scripts/catalog.mjs",
    "cms": "node scripts/pages-cms.mjs",
    "check:external": "node scripts/check-external.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@fontsource/ibm-plex-serif": "5.3.0",
    "astro": "7.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "lighthouse": "13.6.0",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
